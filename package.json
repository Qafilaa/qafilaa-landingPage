{
  "name": "qafilaa-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Qafilaa. Convoy-ride safety app landing page. Ride together. No one left behind.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "cloudfront:errors": "node scripts/cloudfront-error-pages.mjs",
    "design:generate": "python tools/gen.py && python tools/genengine.py && python tools/anyfix.py && python tools/gencss.py",
    "design:verify": "python tools/verify.py",
    "dist:audit": "python tools/audit.py",
    "icons": "python tools/mkicons.py",
    "licenses": "python tools/genlicenses.py",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
