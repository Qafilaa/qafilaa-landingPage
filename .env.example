# Qafilaa landing page — build-time configuration.
#
# Copy to `.env.local` (gitignored) to override. Every variable must be prefixed
# VITE_ to reach the client bundle; anything else is dropped by Vite.

# Backend origin for the waitlist API (src/api.ts).
# Unset = production. Point it at a local backend to develop against one:
#   VITE_API_BASE_URL=http://localhost:5199
VITE_API_BASE_URL=https://api.qafilaa.in

# Analytics is NOT configured here. The GA4 measurement id lives in index.html
# and is gated on hostname (window.QF_GA_HOSTS) so dev, preview and any branch
# deploy can never report into the production property — see index.html and
# src/consent.ts. Nothing loads at all until the visitor accepts.
